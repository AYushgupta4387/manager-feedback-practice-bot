# Copy this file to .env, then add a key when you are ready.
# Without this key, the local server uses a free deterministic reply.
# Create a key in Google AI Studio; never put the key in browser code.
# GEMINI_API_KEY=

# Gemini tries these models in this exact order. Separate model names with commas.
# When a model returns a 429 RESOURCE_EXHAUSTED error, the server skips it until
# Gemini's retry delay expires, then tries the next model before using local replies.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
